{
  "name": "Multi Thread Detector (per call)",
  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "conversation-analyzed", "responseMode": "onReceived" },
      "id": "node-webhook", "name": "Recorder - conversation analyzed",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "notes": "Point your call recorder's 'conversation analyzed' webhook here. The call id arrives in the body." },

    { "parameters": { "method": "GET", "url": "=https://api.gong.io/v2/calls/{{ $json.body.call_id }}",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth" },
      "id": "node-call", "name": "Recorder - get call details",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0],
      "notes": "Fetch the triggering call (account, deal, participants). No Gong? Swap for your recorder's API, or ingest exports via the gtmsi adapters." },

    { "parameters": { "method": "GET", "url": "https://api.gong.io/v2/calls",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "fromDateTime", "value": "={{ $now.minus({ days: 120 }).toISO() }}" } ] } },
      "id": "node-prior", "name": "Recorder - all deal calls",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0],
      "notes": "Pull every prior call on the same deal/account to build the cumulative stakeholder map. Filter to this deal." },

    { "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 2000,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"<<PASTE THE MULTI-THREAD-DETECTOR OPERATING PROMPT (see multi-thread-detector.md)>>\\n\\nCALL:\\n{{ JSON.stringify($('Recorder - get call details').item.json) }}\\n\\nPRIOR CALLS:\\n{{ JSON.stringify($json) }}\" }]\n}" },
      "id": "node-llm", "name": "Claude - threading analysis",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0] },

    { "parameters": { "conditions": { "options": { "caseSensitive": false }, "conditions": [ { "leftValue": "={{ $json.content[0].text }}", "rightValue": "no alert needed", "operator": { "type": "string", "operation": "notContains" } } ] } },
      "id": "node-if", "name": "Only if Medium+ risk",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [880, 0],
      "notes": "Low-risk runs return 'Threading healthy - no alert needed.' and are filtered out here." },

    { "parameters": { "resource": "message", "operation": "post", "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.content[0].text }}" },
      "id": "node-slack", "name": "Slack - post threading alert",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [1100, 0] }
  ],
  "connections": {
    "Recorder - conversation analyzed": { "main": [[{ "node": "Recorder - get call details", "type": "main", "index": 0 }]] },
    "Recorder - get call details": { "main": [[{ "node": "Recorder - all deal calls", "type": "main", "index": 0 }]] },
    "Recorder - all deal calls": { "main": [[{ "node": "Claude - threading analysis", "type": "main", "index": 0 }]] },
    "Claude - threading analysis": { "main": [[{ "node": "Only if Medium+ risk", "type": "main", "index": 0 }]] },
    "Only if Medium+ risk": { "main": [[{ "node": "Slack - post threading alert", "type": "main", "index": 0 }]] }
  },
  "settings": {}, "pinData": {}
}
