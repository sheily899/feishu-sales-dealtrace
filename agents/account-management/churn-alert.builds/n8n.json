{
  "name": "Churn Alert (weekly)",
  "nodes": [
    { "parameters": { "rule": { "interval": [ { "field": "days", "triggerAtHour": 7 } ] } },
      "id": "node-schedule", "name": "Daily - 07:00",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0],
      "notes": "Default daily at 07:00 (cron 0 7 * * *). Adjust to weekly if you prefer a weekly digest." },

    { "parameters": { "method": "GET", "url": "={{ $env.SF_INSTANCE_URL }}/services/data/v60.0/query",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "salesforceOAuth2Api",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "q",
          "value": "SELECT Id, Name, Owner.Name, Renewal_Date__c, Health_Score__c, NPS__c, AnnualRevenue FROM Account WHERE Type = 'Customer' AND Active__c = true" } ] } },
      "id": "node-crm", "name": "CRM - active customers",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0],
      "notes": "Scope ACTIVE customers (exclude open/live deals). Read-only." },

    { "parameters": { "method": "GET", "url": "https://api.gong.io/v2/calls",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "fromDateTime", "value": "={{ $now.minus({ days: 90 }).toISO() }}" } ] } },
      "id": "node-calls", "name": "Recorder - account calls (90d)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0],
      "notes": "Join calls to each active account. For many accounts, precede with a Split In Batches loop. No Gong? Swap for your recorder's API, or ingest exports via the gtmsi adapters." },

    { "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 3000,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"<<PASTE THE CHURN ALERT OPERATING PROMPT (see churn-alert.md)>>\\n\\nACTIVE CUSTOMERS:\\n{{ JSON.stringify($('CRM - active customers').item.json.records) }}\\n\\nCALLS:\\n{{ JSON.stringify($json) }}\" }]\n}" },
      "id": "node-llm", "name": "Claude - churn-risk analysis",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0] },

    { "parameters": { "resource": "message", "operation": "post", "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.content[0].text }}" },
      "id": "node-slack", "name": "Slack - post churn report",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [880, 0],
      "notes": "Post to the CS / account-management channel." }
  ],
  "connections": {
    "Daily - 07:00": { "main": [[{ "node": "CRM - active customers", "type": "main", "index": 0 }]] },
    "CRM - active customers": { "main": [[{ "node": "Recorder - account calls (90d)", "type": "main", "index": 0 }]] },
    "Recorder - account calls (90d)": { "main": [[{ "node": "Claude - churn-risk analysis", "type": "main", "index": 0 }]] },
    "Claude - churn-risk analysis": { "main": [[{ "node": "Slack - post churn report", "type": "main", "index": 0 }]] }
  },
  "settings": {}, "pinData": {}
}
