{
  "name": "Lost-Deal Intel (weekly)",
  "nodes": [
    { "parameters": { "rule": { "interval": [ { "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 8 } ] } },
      "id": "node-schedule", "name": "Weekly - Mon 08:00",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0] },

    { "parameters": { "method": "GET", "url": "={{ $env.SF_INSTANCE_URL }}/services/data/v60.0/query",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "salesforceOAuth2Api",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "q",
          "value": "SELECT Id, Name, Amount, Owner.Name, CloseDate, StageName, Loss_Reason__c FROM Opportunity WHERE IsClosed = true AND IsWon = false AND CloseDate = LAST_N_DAYS:7" } ] } },
      "id": "node-crm", "name": "Salesforce - Closed-Lost (7d)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0] },

    { "parameters": { "method": "GET", "url": "https://api.gong.io/v2/calls",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "fromDateTime", "value": "={{ $now.minus({ days: 30 }).toISO() }}" } ] } },
      "id": "node-calls", "name": "Recorder - fetch calls",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0],
      "notes": "Join calls to the lost deals/accounts. For many deals, precede with a Split In Batches loop. No Gong? Swap for your recorder's API, or ingest exports via the dealtrace adapters." },

    { "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 3000,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"<<PASTE THE LOST-DEAL OPERATING PROMPT (see lost-deal-intel.md)>>\\n\\nLOST DEALS:\\n{{ JSON.stringify($('Salesforce - Closed-Lost (7d)').item.json.records) }}\\n\\nCALLS:\\n{{ JSON.stringify($json) }}\" }]\n}" },
      "id": "node-llm", "name": "Claude - loss analysis",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0] },

    { "parameters": { "resource": "message", "operation": "post", "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.content[0].text }}" },
      "id": "node-slack", "name": "Slack - post report",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [880, 0] }
  ],
  "connections": {
    "Weekly - Mon 08:00": { "main": [[{ "node": "Salesforce - Closed-Lost (7d)", "type": "main", "index": 0 }]] },
    "Salesforce - Closed-Lost (7d)": { "main": [[{ "node": "Recorder - fetch calls", "type": "main", "index": 0 }]] },
    "Recorder - fetch calls": { "main": [[{ "node": "Claude - loss analysis", "type": "main", "index": 0 }]] },
    "Claude - loss analysis": { "main": [[{ "node": "Slack - post report", "type": "main", "index": 0 }]] }
  },
  "settings": {}, "pinData": {}
}
