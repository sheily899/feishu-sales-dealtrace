{
  "name": "Upsell Alert (per call)",
  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "upsell-alert", "responseMode": "onReceived" },
      "id": "node-webhook", "name": "Recorder - conversation analyzed",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "notes": "Point your recorder's 'conversation analyzed' webhook here. The payload should carry the call id." },

    { "parameters": { "method": "GET", "url": "=https://api.gong.io/v2/calls/{{ $json.body.callId }}",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth" },
      "id": "node-call", "name": "Recorder - fetch call",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0],
      "notes": "Fetch the analyzed call (transcript + attendees). No Gong? Swap for your recorder's API, or ingest the export via the gtmsi adapters." },

    { "parameters": { "method": "GET", "url": "={{ $env.SF_INSTANCE_URL }}/services/data/v60.0/query",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "salesforceOAuth2Api",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "q",
          "value": "=SELECT Id, Name, Account.Name, Account.AnnualRevenue, Owner.Name FROM Contact WHERE Email = '{{ $json.primarySpeakerEmail }}'" } ] } },
      "id": "node-crm", "name": "Salesforce - confirm speaker/account",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0],
      "notes": "Confirm the speaker, account, current ACV, and owner so the alert routes correctly. If unmatched, the prompt flags it and still posts." },

    { "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 2000,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"<<PASTE THE UPSELL ALERT OPERATING PROMPT (see upsell-alert.md)>>\\n\\nCALL:\\n{{ JSON.stringify($('Recorder - fetch call').item.json) }}\\n\\nCRM MATCH:\\n{{ JSON.stringify($json) }}\" }]\n}" },
      "id": "node-llm", "name": "Claude - detect + classify signal",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0] },

    { "parameters": { "resource": "message", "operation": "post", "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.content[0].text }}" },
      "id": "node-slack", "name": "Slack - post alert",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [880, 0] }
  ],
  "connections": {
    "Recorder - conversation analyzed": { "main": [[{ "node": "Recorder - fetch call", "type": "main", "index": 0 }]] },
    "Recorder - fetch call": { "main": [[{ "node": "Salesforce - confirm speaker/account", "type": "main", "index": 0 }]] },
    "Salesforce - confirm speaker/account": { "main": [[{ "node": "Claude - detect + classify signal", "type": "main", "index": 0 }]] },
    "Claude - detect + classify signal": { "main": [[{ "node": "Slack - post alert", "type": "main", "index": 0 }]] }
  },
  "settings": {}, "pinData": {}
}
