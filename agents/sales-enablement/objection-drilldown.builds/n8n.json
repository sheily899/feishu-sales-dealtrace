{
  "name": "Objection Drilldown (weekly)",
  "nodes": [
    { "parameters": { "rule": { "interval": [ { "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 8 } ] } },
      "id": "node-schedule", "name": "Weekly - Mon 08:00",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0] },

    { "parameters": { "method": "GET", "url": "https://api.gong.io/v2/calls",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "fromDateTime", "value": "={{ $now.minus({ days: 7 }).toISO() }}" } ] } },
      "id": "node-calls", "name": "Recorder - this week's calls",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0],
      "notes": "Team calls in the last 7 days. No Gong? Swap for your recorder's API, or ingest exports via the dealtrace adapters." },

    { "parameters": { "method": "GET", "url": "https://api.gong.io/v2/calls",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth",
        "sendQuery": true, "queryParameters": { "parameters": [ { "name": "fromDateTime", "value": "={{ $now.minus({ days: 14 }).toISO() }}" }, { "name": "toDateTime", "value": "={{ $now.minus({ days: 7 }).toISO() }}" } ] } },
      "id": "node-prior", "name": "Recorder - prior week (for trends)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0] },

    { "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 3000,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"<<PASTE THE OBJECTION DRILLDOWN OPERATING PROMPT (see objection-drilldown.md)>>\\n\\nTHIS WEEK:\\n{{ JSON.stringify($('Recorder - this week\\'s calls').item.json) }}\\n\\nLAST WEEK:\\n{{ JSON.stringify($json) }}\" }]\n}" },
      "id": "node-llm", "name": "Claude - objection analysis",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0] },

    { "parameters": { "resource": "message", "operation": "post", "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.content[0].text }}" },
      "id": "node-slack", "name": "Slack - post report",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [880, 0] }
  ],
  "connections": {
    "Weekly - Mon 08:00": { "main": [[{ "node": "Recorder - this week's calls", "type": "main", "index": 0 }]] },
    "Recorder - this week's calls": { "main": [[{ "node": "Recorder - prior week (for trends)", "type": "main", "index": 0 }]] },
    "Recorder - prior week (for trends)": { "main": [[{ "node": "Claude - objection analysis", "type": "main", "index": 0 }]] },
    "Claude - objection analysis": { "main": [[{ "node": "Slack - post report", "type": "main", "index": 0 }]] }
  },
  "settings": {}, "pinData": {}
}
