{
  "name": "Compliance Checker (per call)",
  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "conversation-analyzed", "responseMode": "onReceived" },
      "id": "node-webhook", "name": "Recorder - conversation analyzed",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0],
      "notes": "Point your call recorder's 'conversation analyzed' webhook here. Payload should carry the call id." },

    { "parameters": { "method": "GET", "url": "=https://api.gong.io/v2/calls/{{ $json.body.call_id }}/transcript",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpBasicAuth" },
      "id": "node-call", "name": "Recorder - get call details",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0],
      "notes": "Fetch the transcript + metadata for the analyzed call. No Gong? Swap for your recorder's API, or ingest the export via the dealtrace adapters." },

    { "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 2000,\n  \"messages\": [{ \"role\": \"user\", \"content\": \"<<PASTE THE COMPLIANCE CHECKER OPERATING PROMPT (see compliance-checker.md). Output NO_VIOLATIONS if the call is clean.>>\\n\\nCALL:\\n{{ JSON.stringify($json) }}\" }]\n}" },
      "id": "node-llm", "name": "Claude - scan for violations",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0] },

    { "parameters": { "conditions": { "options": { "caseSensitive": true }, "combinator": "and",
        "conditions": [ { "leftValue": "={{ $json.content[0].text }}", "rightValue": "NO_VIOLATIONS", "operator": { "type": "string", "operation": "notContains" } } ] } },
      "id": "node-if", "name": "Only if a violation",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [660, 0] },

    { "parameters": { "resource": "message", "operation": "post", "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.content[0].text }}" },
      "id": "node-slack", "name": "Slack - post alert",
      "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [880, 0],
      "notes": "Compliance / sales-ops channel. Only reached when a violation was found." }
  ],
  "connections": {
    "Recorder - conversation analyzed": { "main": [[{ "node": "Recorder - get call details", "type": "main", "index": 0 }]] },
    "Recorder - get call details": { "main": [[{ "node": "Claude - scan for violations", "type": "main", "index": 0 }]] },
    "Claude - scan for violations": { "main": [[{ "node": "Only if a violation", "type": "main", "index": 0 }]] },
    "Only if a violation": { "main": [[{ "node": "Slack - post alert", "type": "main", "index": 0 }]] }
  },
  "settings": {}, "pinData": {}
}
