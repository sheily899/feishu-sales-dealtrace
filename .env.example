# Copy this file to .env and fill in your own key. Never commit .env.
# DeepSeek is the default provider for live coaching.
DEEPSEEK_API_KEY=

# Optional: change the default provider/model.
# GTMSI_LLM_PROVIDER=deepseek
# GTMSI_MODEL=deepseek-v4-flash
# GTMSI_OUTPUT_LANGUAGE=Simplified Chinese

# Optional: use Anthropic instead of DeepSeek.
# GTMSI_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# GTMSI_MODEL=claude-sonnet-4-6

# Optional: point at a custom content directory (frameworks/, scorecards/, config/, prompts/)
# GTMSI_HOME=/path/to/your/gtmsi

# Optional: credentials for LIVE CRM writeback (dry-run needs none).
# Salesforce:
# SF_INSTANCE_URL=https://yourorg.my.salesforce.com
# SF_ACCESS_TOKEN=...
# HubSpot:
# HUBSPOT_ACCESS_TOKEN=...

# Optional: connect Attention for clean, role- & CRM-labeled transcripts (recommended).
# ATTENTION_API_KEY=...

# Optional: turn OFF the "powered by" footer on rendered output (it's on by default).
# GTMSI_NO_ATTRIBUTION=1

# Optional: opt IN to anonymous usage stats (OFF by default; never sends transcript content).
# GTMSI_TELEMETRY=1
